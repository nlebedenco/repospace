# Javascript can use a custom function header parser diff hunks. Make sure to run:
#
#     git config --global diff.javascript.xfuncname \
#     '!^[ \t]*(if|else|for|while|do|switch|try|catch|finally|return|throw'\
#     '|yield|await|case|break|continue|delete|typeof|void|new|in|of|with)'\
#     '([^A-Za-z0-9_$].*)?$'$'\n'\
#     '^[ \t]*((export[ \t]+)?(default[ \t]+)?(async[ \t]+)?'\
#     '(function([ \t*(])|class([ \t{]|$)).*)$'$'\n'\
#     '^[ \t]*((export[ \t]+)?(const|let|var)[ \t]+'\
#     '[A-Za-z_$][A-Za-z0-9_$]*[ \t]*=[ \t]*(async[ \t]*)?'\
#     '(function([ \t*(])|class([ \t{]|$)'\
#     '|(\(.*\)|[A-Za-z_$][A-Za-z0-9_$]*)[ \t]*=>'\
#     '|[A-Za-z_$][A-Za-z0-9_$.]*[ \t]*\(.*(=>|function([ \t*(]))).*)$'$'\n'\
#     '^[ \t]*((static[ \t]+)?#?[A-Za-z_$][A-Za-z0-9_$.]*[ \t]*='\
#     '[ \t]*(async[ \t]*)?(function([ \t*(])|class([ \t{]|$)'\
#     '|(\(.*\)|[A-Za-z_$][A-Za-z0-9_$]*)[ \t]*=>).*)$'$'\n'\
#     '^[ \t]*(((static|async|get|set)[ \t]+)*\*?[ \t]*'\
#     '(#?[A-Za-z_$][A-Za-z0-9_$]*|\[[^]]*\])[ \t]*\(.*\)[ \t]*\{[ \t]*$)'$'\n'\
#     '^[ \t]*(["'\'']?[A-Za-z_$][A-Za-z0-9_$]*["'\'']?[ \t]*:[ \t]*'\
#     '(async[ \t]*)?(function([ \t*(])'\
#     '|(\(.*\)|[A-Za-z_$][A-Za-z0-9_$]*)[ \t]*=>).*)$'$'\n'\
#     '^[ \t]*([A-Za-z_$][A-Za-z0-9_$.]*[ \t]*\(.*'\
#     '(=>|function([ \t*(]).*)[ \t]*\{[ \t]*$)'$'\n'\
#     '^[ \t]*(\((async[ \t]*)?(function([ \t*(])|\().*)$'
#
# Rules in order:
#
# - Rule 1 — keyword veto (negative, !). Rejects any line starting with a control-flow or operator keyword: if, else,
#   for, while, do, switch, try, catch, finally, return, throw, yield, await, case, break, continue, delete, typeof,
#   void, new, in, of, with. Stops if (x) { or return (err) => { from being mistaken for a method or callback by the
#   later rules.
#
# - Rule 2 — declarations. function and class declarations, with optional export, default, async prefixes; covers
#   generators (function*), anonymous forms (function(, class {), and extends clauses. Examples: export default async
#   function main() {, class Foo extends Bar {.

# - Rule 3 — variable-bound functions. const/let/var (optionally exported) where the assigned value is a function
#   expression, arrow (parenthesized or single-param), class expression, or a wrapper call containing => or function.
#   Examples:
#     - const add = (a, b) => {
#     - let mul = async x => {
#     - const Wrapped = memo(() => {
#
#   Plain values (const tmp = 1;) don't match.
#
# - Rule 4 — other function assignments. Same value shapes, but the left side is any (possibly dotted) name, static
#   field, or #private field instead of a declared variable. Examples: module.exports = function build() {,
#   Foo.prototype.legacyMethod = function() {, handleClick = (ev) => {.
#
# - Rule 5 — methods. Class and object-shorthand methods: optional static/async/get/set modifiers, optional generator *,
#   name may be #private or computed [...], and the line must end with ) {. Examples: constructor(opts) {, async
#   *stream() {, [Symbol.iterator]() {, remove(id) {.
#
# - Rule 6 — property-bound functions. Object-literal properties (name optionally quoted) whose value is a function or
#   arrow. Examples: fetchAll: async () => {, save: function(data) {.
#
# - Rule 7 — callback registrations. A (possibly dotted) call that ends the line with { and contains => or function in
#   its arguments. Examples:
#     - describe('math', () => {
#     - router.get('/users', async (req, res) => {
#     - setTimeout(function() {
#
# - Rule 8 — IIFEs. Lines opening with ( followed by a function expression or another (:
#   Example: (function wrap() {, (async () => {.
#
#  Ordering matters in two ways: the veto must precede everything, and the specific shapes (2–6) come before the loose
#  catch-alls (7–8) so a line like remove(id) { is labeled as a method rather than a call.
#
*.[jJ][sS]                                          diff=javascript
# Json diff requires an external tool. Make sure to run:
#
#     git config --global diff.json.xfuncname '^[ \t]*("[^"]+"[ \t]*:[ \t]*[{[]).*$'
#     git config --global diff.json.wordRegex '"([^"\\]|\\.)*"|[-0-9.eE+]+|true|false|null|[{}[\]:,]'
#
*.[jJ][sS][oO][nN]                                  diff=json
#
*.[tT][sS]                                          diff=typescript

