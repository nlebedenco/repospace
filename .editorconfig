# EditorConfig: https://editorconfig.org/

# top-most EditorConfig file
root = true

# All (Defaults)
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100
indent_style = space
indent_size = 4

# Git commit messages
[COMMIT_EDITMSG]
max_line_length = 75

# Git modules manifest
[.gitmodules]
indent_style = tab
indent_size = 4

# License
[LICENSE]
max_line_length = 80

# JSON
[*.json]
indent_size = 2

# Markdown
[*.md]
max_line_length = 80

# Windows Command Script
[*.{bat,bat.in,cmd,cmd.in,ps1}]
end_of_line = crlf

# YAML
[{*.apinotes,*.yaml,*.yml}]
indent_size = 2
